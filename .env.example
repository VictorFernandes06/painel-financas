# =============================================================
#  Painel de Finanças Pessoais · configuração do Google Sheets
#  Copie este arquivo para ".env" e preencha. NUNCA envie o .env
#  nem o JSON da Service Account para o GitHub.
# =============================================================

# 1) LINK DA PLANILHA ------------------------------------------
# Cole o link completo ou só o ID. Precisa ser uma planilha do
# Google (link com /spreadsheets/d/). Arquivos .xlsx do Drive não
# funcionam: abra no Drive e use "Arquivo > Salvar como Planilhas Google".
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/COLE_O_ID_AQUI/edit

# A planilha precisa ter as abas "Receitas", "Despesas" e "Cadastro"
# (modelo Oxigênio Financeiro). O cabeçalho pode estar na linha 1 ou 2.

# 2) CREDENCIAIS PARA LER E GRAVAR (Service Account) -----------
# Use UMA das três opções abaixo. Depois compartilhe a planilha
# com o e-mail da Service Account como "Editor".

# Opção A (recomendada): caminho do arquivo JSON baixado do Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# Opção B: o conteúdo do JSON inteiro em uma linha.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Opção C: só os dois campos necessários.
# GOOGLE_CLIENT_EMAIL=painel-financas@seu-projeto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3) ALTERNATIVA SOMENTE LEITURA (opcional) ---------------------
# Uma chave de API só consegue LER planilhas públicas ("qualquer
# pessoa com o link"). Inserir, editar e excluir exigem a Service Account.
# GOOGLE_API_KEY=

# 4) OUTROS -------------------------------------------------------
# Porta do backend (o Vite repassa /api para ela).
API_PORT=3001

# true = usa dados de exemplo em memória, sem tocar no Google.
DEMO_MODE=false
